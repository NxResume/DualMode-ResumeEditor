// Cloudflare Pages Functions + D1 部署配置
// 对应 Nitro preset: cloudflare_pages 的产物 dist
//
// 前置准备（只做一次）：
//   1) 创建 D1 数据库（已创建：resume）：
//        wrangler d1 create resume
//   2) 建表 + 迁移数据（MySQL → D1）：
//        wrangler d1 execute resume --remote --file=migrations/d1.sql
//   3) 部署：
//        pnpm build:cf && wrangler pages deploy dist
//
// 注意：
//   · D1 是 Cloudflare 原生 SQLite（HTTP 协议），绑定名 env.DB，
//     无 TCP/mysql2/Hyperdrive 兼容问题
//   · Pages 生产环境的 secrets（AUTH_SECRET、OAuth client_id/secret 等）推荐用
//     Dashboard → Pages Project → Settings → Environment variables 里配，不要写
//     进 git；wrangler.jsonc 里的 `vars` 只放非敏感变量（AUTH_ORIGIN 等公开变量）。
{
  // Pages Project 名；与 Cloudflare 侧实际 Pages 项目名保持一致
  "name": "resume",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    // bcrypt、nodemailer 等依赖 Node 原生模块
    "nodejs_compat"
  ],

  // Pages Functions 资源限制
  "limits": {
    "cpu_ms": 30000,
    "memory": "256 MB"
  },

  // ============================================================
  // D1 数据库绑定
  //   binding 名 = "DB"   → runtime: env.DB
  // ============================================================
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resume",
      "database_id": "ffe37c47-09c5-4112-9c82-0a857776daf8"
    }
  ],

  // -------------------------------------------------------------
  // 非敏感变量（公开 OK）。敏感 secret 请在 Pages Dashboard 里设置。
  //
  //   常见要配的 secret（Dashboard → Pages → Settings → Environment variables）：
  //     AUTH_SECRET                     （sidebase-auth 必需）
  //     AUTH_ORIGIN                     （生产域名）
  //     GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
  //     GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
  //     GITEE_CLIENT_ID  / GITEE_CLIENT_SECRET
  //     LINUXDO_CLIENT_ID / LINUXDO_CLIENT_SECRET
  //     SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS  （verify-email 用）
  // -------------------------------------------------------------
  // AUTH_ORIGIN 是公开域名（非敏感），放 vars 由 wrangler 部署时注入；
  // 其余 secrets 在 Pages Dashboard 配置，不要在 vars 里重复定义
  "vars": {
    "AUTH_ORIGIN": "https://resume.ryanuo.cc/api/auth"
  },

  // Nitro preset=cloudflare_pages 构建后 Pages 静态 + Functions 打包产物根目录
  "pages_build_output_dir": "dist"
}
